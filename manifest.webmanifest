{
  "id": "./",
  "name": "Hisaab",
  "short_name": "Hisaab",
  "description": "Track your daily milk bill and settle up with your milkman",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "finance",
    "lifestyle",
    "utilities"
  ],
  "background_color": "#faf9f6",
  "theme_color": "#faf9f6",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "No milk today",
      "short_name": "No milk",
      "description": "Mark today as no milk",
      "url": "./?action=missed",
      "icons": [
        {
          "src": "icons/shortcut-nomilk.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Milk came today",
      "short_name": "Milk came",
      "description": "Mark today as milk came",
      "url": "./?action=came",
      "icons": [
        {
          "src": "icons/shortcut-came.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Open calendar",
      "short_name": "Calendar",
      "description": "See the month and share the bill",
      "url": "./?tab=calendar",
      "icons": [
        {
          "src": "icons/shortcut-calendar.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}